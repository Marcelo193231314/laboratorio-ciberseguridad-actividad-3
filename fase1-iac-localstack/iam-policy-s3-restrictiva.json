{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RestringirAccesoPorRolExclusivo",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/RolAuditoriaSeguridad"
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::actividad3-seguro-local/*"
    },
    {
      "Sid": "DenegarTodoAccesoNoAutorizado",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::actividad3-seguro-local",
        "arn:aws:s3:::actividad3-seguro-local/*"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:userId": "arn:aws:iam::123456789012:role/RolAuditoriaSeguridad:*"
        }
      }
    }
  ]
}
